[Desktop Entry]
Type=Application
Name=rfiles
GenericName=File Manager
Comment=Fast file manager with tabs, dual panes and previews
Exec=rfiles %U
Icon=rfiles
Terminal=false
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
Keywords=files;folders;explorer;browser;manager;
StartupNotify=true
StartupWMClass=rfiles
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=rfiles --new-window
