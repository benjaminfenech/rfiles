# Maintainer: Benjamin Fenech <benjamin@fenech.dev>
# rfiles, Linux port: built from the latest commit of the GitHub repository.
# Build and install from this folder with: makepkg -si

pkgname=rfiles-git
_name=rfiles
pkgver=0.3.0
pkgrel=1
pkgdesc='Fast file manager with tabs, dual panes and previews'
arch=('x86_64' 'aarch64')
url='https://github.com/benjaminfenech/rfiles'
license=('MIT')
depends=(
  'alsa-lib'
  'fontconfig'
  'freetype2'
  'libgcc'
  'glibc'
  'hicolor-icon-theme'
  'libglvnd'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'vulkan-icd-loader'
  'wayland'
)
makedepends=('cargo' 'git' 'pkgconf')
optdepends=(
  'poppler: PDF previews'
  'libavif: full-size AVIF images'
  'libheif: full-size HEIC images'
  'libraw: camera RAW photos at full quality'
  'ffmpeg: video formats rfiles cannot play on its own'
  'kio-fuse: network locations (smb://, sftp://, ftp://) on KDE'
  'gvfs-smb: network locations on GNOME and others (with gvfs)'
  'udisks2: mounting and ejecting drives'
  'xdg-desktop-portal: file dialogs and "Open with"'
  'git: git status and actions in repositories'
)
provides=("$_name")
# rfiles was called rustyfiles before: this package takes the old one's place
conflicts=("$_name" 'rustyfiles' 'rustyfiles-git')
replaces=('rustyfiles-git')
options=('!lto')
# CI builds a given checkout instead: RFILES_SOURCE='git+file:///path#commit=<sha>'
source=("$_name::${RFILES_SOURCE:-git+$url.git}")
sha256sums=('SKIP')

pkgver() {
  cd "$_name"
  # the workspace version, the number of commits and the commit: 0.3.0.r95.gabc1234
  local ver
  ver=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)
  printf '%s.r%s.g%s' "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p rf-app --bins
}

package() {
  cd "$_name"
  # DirectLook is found next to rfiles: both live in /usr/lib/rfiles
  install -Dm755 target/release/rfiles "$pkgdir/usr/lib/$_name/rfiles"
  install -Dm755 target/release/directlook "$pkgdir/usr/lib/$_name/directlook"
  install -dm755 "$pkgdir/usr/bin"
  ln -s "/usr/lib/$_name/rfiles" "$pkgdir/usr/bin/rfiles"

  install -Dm644 packaging/linux/rfiles.desktop "$pkgdir/usr/share/applications/rfiles.desktop"
  # rfiles as the desktop portal's Open/Save dialog (Settings turns it on)
  install -Dm644 packaging/linux/rfiles.portal "$pkgdir/usr/share/xdg-desktop-portal/portals/rfiles.portal"
  install -Dm644 packaging/linux/org.freedesktop.impl.portal.desktop.rfiles.service \
    "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.rfiles.service"
  install -Dm644 packaging/linux/io.github.benjaminfenech.rfiles.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.benjaminfenech.rfiles.metainfo.xml"
  install -Dm644 crates/rf-app/assets/rfiles.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/rfiles.svg"
  install -Dm644 crates/rf-app/assets/rfiles.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/rfiles.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
